esphome:
  name: buttonbot
  friendly_name: ButtonBot
  comment: "ESP32-C3 SG90 Button Pusher"

esp32:
  board: esp32-c3-devkitm-1
  variant: esp32c3
  framework:
    type: esp-idf

# Logging
logger:

# Home Assistant API
api:
  encryption:
    key: !secret buttonbot__encryption_key

# Over-the-air updates
ota:
  - platform: esphome
    encryption:

# WiFi connection
wifi:
  ssid: !secret wifi_ssid
  password: !secret wifi_password

  ap:
    ssid: "ButtonBot Fallback"
    password: "buttonbot1234"

captive_portal:

# SG90 servo connected to GPIO4
output:
  - platform: ledc
    id: servo_output
    pin: GPIO4
    frequency: 50Hz

# SG90 servo settings
servo:
  - id: button_servo
    output: servo_output

    # Extended travel range
    # Default minimum is 3%
    min_level: 1.5%
    idle_level: 7.5%
    max_level: 12.0%

    # Smooth servo movement
    transition_length: 300ms

    # Automatically release motor after movement
    auto_detach_time: 2s

# Adjustable Home Assistant settings
number:
  # Resting / retracted position
  - platform: template
    name: "Rest Position"
    id: rest_position
    icon: mdi:arrow-collapse-up
    min_value: -100
    max_value: 100
    step: 5
    initial_value: -100
    optimistic: true
    restore_value: true
    entity_category: config

  # Forward / pressing position
  - platform: template
    name: "Press Position"
    id: press_position
    icon: mdi:arrow-collapse-down
    min_value: -100
    max_value: 100
    step: 5
    initial_value: 0
    optimistic: true
    restore_value: true
    entity_category: config

  # How long the button stays pressed
  - platform: template
    name: "Press Duration"
    id: press_duration
    icon: mdi:timer-outline
    unit_of_measurement: ms
    min_value: 100
    max_value: 2000
    step: 100
    initial_value: 400
    optimistic: true
    restore_value: true
    entity_category: config

# Button press sequence
script:
  - id: press_sequence
    mode: single
    then:
      # Move servo forward
      - servo.write:
          id: button_servo
          level: !lambda |-
            return id(press_position).state / 100.0f;

      # Wait for servo to move
      - delay: 500ms

      # Hold physical button
      - delay: !lambda |-
          return (uint32_t) id(press_duration).state;

      # Retract servo to rest position
      - servo.write:
          id: button_servo
          level: !lambda |-
            return id(rest_position).state / 100.0f;

      # Allow full retraction
      - delay: 1500ms

      # Release servo power
      - servo.detach: button_servo

# Home Assistant buttons
button:
  # Main button
  - platform: template
    name: "Press Button"
    id: press_button
    icon: mdi:gesture-tap-button
    on_press:
      - script.execute: press_sequence

  # Manually move servo to rest
  - platform: template
    name: "Move to Rest"
    icon: mdi:arrow-up-bold
    on_press:
      - script.stop: press_sequence
      - servo.write:
          id: button_servo
          level: !lambda |-
            return id(rest_position).state / 100.0f;

  # Manually move servo forward
  - platform: template
    name: "Test Press"
    icon: mdi:arrow-down-bold
    on_press:
      - script.stop: press_sequence
      - servo.write:
          id: button_servo
          level: !lambda |-
            return id(press_position).state / 100.0f;

# Diagnostics
sensor:
  - platform: wifi_signal
    name: "WiFi Signal"
    update_interval: 60s
    entity_category: diagnostic

  - platform: uptime
    name: "Uptime"
    update_interval: 60s
    entity_category: diagnostic
